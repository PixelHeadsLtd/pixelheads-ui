{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,

  "newProjectRoot": "projects",

  "projects": {
    "components": {
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "projectType": "library",
      "prefix": "ph",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/components/tsconfig.lib.json",
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/components/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/components/**/*.ts",
              "projects/components/**/*.html"
            ]
          }
        }
      }
    },
    "styles": {
      "root": "projects/styles",
      "sourceRoot": "projects/styles/src",
      "projectType": "library",
      "prefix": "ph",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/styles/tsconfig.lib.json",
            "project": "projects/styles/ng-package.json"
          }
        }
      }
    },
    "pixelheads-ui": {
      "root": "apps/pixelheads-ui",
      "sourceRoot": "apps/pixelheads-ui/src",
      "projectType": "application",
      "prefix": "app",

      "schematics": {},

      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/pixelheads-ui",
            "index": "apps/pixelheads-ui/src/index.html",
            "main": "apps/pixelheads-ui/src/main.ts",
            "polyfills": "apps/pixelheads-ui/src/polyfills.ts",
            "tsConfig": "apps/pixelheads-ui/tsconfig.app.json",

            "assets": [
              "apps/pixelheads-ui/src/favicon.ico",
              "apps/pixelheads-ui/src/assets",
              "apps/pixelheads-ui/src/web.config"
            ],

            "styles": [
              "projects/styles/src/scss/styles.scss",
              "apps/pixelheads-ui/src/styles.scss",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.bubble.css",
              "node_modules/quill/dist/quill.snow.css"
            ],

            "scripts": [
              "node_modules/postscribe/dist/postscribe.min.js"
            ],

            "aot": true,
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "apps/pixelheads-ui/src/environments/environment.ts",
                  "with": "apps/pixelheads-ui/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },

        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "pixelheads-ui:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "pixelheads-ui:build:production"
            }
          }
        },

        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "pixelheads-ui:build"
          }
        },

        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "scripts": [
              "node_modules/quill/dist/quill.min.js",
              "node_modules/postscribe/dist/postscribe.min.js"
            ],
            "tsConfig": "apps/pixelheads-ui/tsconfig.spec.json"
          }
        },

        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "apps/pixelheads-ui/**/*.ts",
              "apps/pixelheads-ui/**/*.html"
            ]
          }
        }
      }
    }
  },

  "defaultProject": "pixelheads-ui",

  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },

  "cli": {
    "analytics": false
  }
}
