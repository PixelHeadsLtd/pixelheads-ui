{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "components": {
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "projectType": "library",
      "prefix": "aa",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/components/tsconfig.lib.json",
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/components/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/components/**/*.ts",
              "projects/components/**/*.html"
            ]
          }
        }
      }
    },
    "style-guide": {
      "root": "projects/style-guide/",
      "sourceRoot": "projects/style-guide/src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/style-guide",
            "index": "projects/style-guide/src/index.html",
            "main": "projects/style-guide/src/main.ts",
            "polyfills": "projects/style-guide/src/polyfills.ts",
            "tsConfig": "projects/style-guide/tsconfig.app.json",
            "assets": [
              "projects/style-guide/src/favicon.ico",
              "projects/style-guide/src/assets",
              "projects/style-guide/src/web.config"
            ],
            "styles": [
              "projects/styles/src/scss/styles.scss",
              "projects/style-guide/src/styles.scss",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.bubble.css",
              "node_modules/quill/dist/quill.snow.css"
            ],
            "scripts": [
              "./node_modules/quill/dist/quill.min.js",
              "./node_modules/postscribe/dist/postscribe.min.js"
            ],
            "aot": true,
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/style-guide/src/environments/environment.ts",
                  "with": "projects/style-guide/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "style-guide:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "style-guide:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "style-guide:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "scripts": [
              "./node_modules/quill/dist/quill.min.js",
              "./node_modules/postscribe/dist/postscribe.min.js"
            ],
            "tsConfig": "projects/style-guide/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/style-guide/**/*.ts",
              "projects/style-guide/**/*.html"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "style-guide",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": false
  }
}
