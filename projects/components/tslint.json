{
  "extends": "../../tslint.json",
  "rules": {
    "directive-selector": [
      true,
      "attribute",
      "aa",
      "camelCase"
    ],
    "component-selector": [
      true,
      "element",
      "aa",
      "kebab-case"
    ],
    "max-line-length": [
      true, 
      {
        "limit": 300, 
        "ignore-pattern": "^import [^,]+ from |^export | implements"
      }
    ]
  }
}
